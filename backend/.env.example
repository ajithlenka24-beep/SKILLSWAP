# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_SECRET_KEY=replace-with-another-long-random-secret-32-chars

# Paste the PostgreSQL connection string from Supabase (Connect -> Session pooler).
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Optional: keep the tables in their own schema when sharing a database.
# DB_SCHEMA=skillswap

# Gemini (AI roadmap). Choose a model currently available to your key.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash

# LinkedIn verification ("Sign In with LinkedIn using OpenID Connect").
# Create an app at https://www.linkedin.com/developers/apps and add this
# redirect URL in the app's Auth tab:
#   local:  http://127.0.0.1:5000/api/linkedin/callback
#   live:   https://YOUR-APP.onrender.com/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional overrides (normally auto-detected from the site address):
# LINKEDIN_REDIRECT_URI=https://YOUR-APP.onrender.com/api/linkedin/callback
# FRONTEND_URL=https://YOUR-APP.onrender.com
# CORS_ORIGINS=*
